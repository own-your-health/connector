// The CPU bench's Worker (scripts/bench.mjs): the connector, with Google
// answered by a local fake. Local only; no account, no deploy.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "own-your-health-connector-bench",
  "main": "worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "bench-oauth-kv" }],
  "d1_databases": [{ "binding": "AUDIT", "database_name": "bench-audit", "database_id": "00000000-0000-0000-0000-000000000000" }],
  "vars": { "ASSISTANTS": "claude,loopback", "TIME_ZONE": "UTC" }
}
