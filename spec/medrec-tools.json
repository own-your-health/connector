{
  "tools": [
    {
      "name": "medrec_summary",
      "title": "Summary",
      "description": "The people, and with person their summary. Use it first. Medicines, conditions, allergies, vaccines, results, visits, bills.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "person": {
            "type": "string",
            "description": "Name, alias or id; omit for the people."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "people": {
            "type": "array",
            "items": {
              "required": [
                "id",
                "name",
                "adult",
                "documents",
                "records",
                "studies",
                "notes"
              ],
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "birth_date": {
                  "type": "string"
                },
                "adult": {
                  "type": "boolean"
                },
                "documents": {
                  "type": "integer"
                },
                "records": {
                  "type": "integer"
                },
                "studies": {
                  "type": "integer"
                },
                "notes": {
                  "type": "integer"
                },
                "newest": {
                  "type": "string"
                },
                "last_import": {
                  "type": "string"
                }
              }
            }
          },
          "summary": {
            "type": "object",
            "properties": {
              "person": {
                "type": "string"
              },
              "as_of": {
                "type": "string"
              },
              "counts": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer"
                }
              },
              "sources": {
                "type": "array",
                "items": {
                  "required": [
                    "source",
                    "records"
                  ],
                  "type": "object",
                  "properties": {
                    "source": {
                      "type": "string"
                    },
                    "records": {
                      "type": "integer"
                    },
                    "newest": {
                      "type": "string"
                    }
                  }
                }
              },
              "sections": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "section": {
                      "type": "string"
                    },
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "plain_name": {
                            "type": "string"
                          },
                          "date": {
                            "type": "string"
                          },
                          "detail": {
                            "type": "string"
                          },
                          "standing": {
                            "type": "string"
                          },
                          "says": {
                            "type": "string"
                          },
                          "source": {
                            "type": "string"
                          },
                          "id": {
                            "type": "string"
                          },
                          "private": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "name"
                        ]
                      }
                    },
                    "more": {
                      "type": "integer"
                    },
                    "note": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "section",
                    "items",
                    "more"
                  ]
                }
              }
            },
            "required": [
              "person",
              "as_of",
              "counts",
              "sources",
              "sections"
            ]
          }
        },
        "required": [
          "people"
        ]
      },
      "annotations": {
        "title": "Summary",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "medrec_search",
      "title": "Search records",
      "description": "What has every word of query, best first. A doctor, test, medicine or clinic. labs or blood tests finds every lab result.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Words to find."
          },
          "person": {
            "type": "string",
            "description": "Name, alias or id."
          },
          "since": {
            "type": "string",
            "description": "YYYY-MM-DD."
          },
          "until": {
            "type": "string",
            "description": "YYYY-MM-DD, inclusive."
          },
          "limit": {
            "type": "integer",
            "maximum": 200,
            "minimum": 1,
            "description": "Most records to return, 1 to 200 (default 25)."
          },
          "cursor": {
            "type": "string",
            "description": "The `next_cursor` of the previous page of this same query, to continue it; omit for the first page."
          },
          "response_format": {
            "type": "string",
            "enum": [
              "concise",
              "detailed"
            ],
            "description": "`concise` (default): the fields a person reads. `detailed`: adds ids, timestamps and provider detail."
          }
        },
        "required": [
          "query"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "person": {
                  "type": "string"
                },
                "kind": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "date": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "snippet": {
                  "type": "string"
                },
                "not_shown": {
                  "type": "string"
                },
                "private": {
                  "type": "string"
                }
              },
              "required": [
                "person",
                "kind",
                "id",
                "title",
                "snippet"
              ]
            }
          },
          "returned": {
            "type": "integer",
            "minimum": 0
          },
          "next_cursor": {
            "type": "string"
          },
          "truncated": {
            "type": "boolean"
          },
          "hint": {
            "type": "string"
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "code",
                "message"
              ]
            }
          }
        },
        "required": [
          "items",
          "returned"
        ]
      },
      "annotations": {
        "title": "Search records",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "medrec_records",
      "title": "List records",
      "description": "One kind of record, newest first. events: what happened, one per visit, stay or fill, with you_owe; id gives one in full. results with name: one test over time.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "medications",
              "conditions",
              "allergies",
              "immunizations",
              "visits",
              "procedures",
              "results",
              "tests",
              "reports",
              "claims",
              "coverage",
              "bills",
              "documents",
              "notes",
              "timeline",
              "events"
            ],
            "description": "visits: encounters. tests: each test's latest result. bills: filed statements. timeline: all."
          },
          "person": {
            "type": "string",
            "description": "Name, alias or id."
          },
          "since": {
            "type": "string",
            "description": "YYYY-MM-DD."
          },
          "until": {
            "type": "string",
            "description": "YYYY-MM-DD, inclusive."
          },
          "active": {
            "type": "boolean",
            "description": "Current ones only."
          },
          "name": {
            "type": "string",
            "description": "A code (`4548-4`) or words."
          },
          "doc_type": {
            "type": "string",
            "description": "`lab_report`, `bill`, `eob`... (`documents`)."
          },
          "id": {
            "type": "string",
            "description": "One event (`events`)."
          },
          "limit": {
            "type": "integer",
            "maximum": 200,
            "minimum": 1,
            "description": "Most records to return, 1 to 200 (default 25)."
          },
          "cursor": {
            "type": "string",
            "description": "The `next_cursor` of the previous page of this same query, to continue it; omit for the first page."
          },
          "response_format": {
            "type": "string",
            "enum": [
              "concise",
              "detailed"
            ],
            "description": "`concise` (default): the fields a person reads. `detailed`: adds ids, timestamps and provider detail."
          }
        },
        "required": [
          "kind"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string"
                },
                "person": {
                  "type": "string"
                },
                "date": {
                  "type": "string"
                },
                "end": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "plain_name": {
                  "type": "string"
                },
                "detail": {
                  "type": "string"
                },
                "not_shown": {
                  "type": "string"
                },
                "status": {
                  "type": "string"
                },
                "standing": {
                  "type": "string"
                },
                "says": {
                  "type": "string"
                },
                "source": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "code": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                },
                "unit": {
                  "type": "string"
                },
                "range": {
                  "type": "string"
                },
                "flag": {
                  "type": "string"
                },
                "results": {
                  "type": "integer"
                },
                "amount_due": {
                  "type": "string"
                },
                "due_date": {
                  "type": "string"
                },
                "doc_type": {
                  "type": "string"
                },
                "has_text": {
                  "type": "boolean"
                },
                "you_owe": {
                  "type": "string"
                },
                "private": {
                  "type": "string"
                },
                "provider_labels": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": true
                  }
                },
                "fields": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "required": [
                "kind",
                "person",
                "title",
                "id"
              ]
            }
          },
          "returned": {
            "type": "integer",
            "minimum": 0
          },
          "next_cursor": {
            "type": "string"
          },
          "truncated": {
            "type": "boolean"
          },
          "hint": {
            "type": "string"
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "code",
                "message"
              ]
            }
          }
        },
        "required": [
          "items",
          "returned"
        ]
      },
      "annotations": {
        "title": "List records",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "medrec_document",
      "title": "Read a document",
      "description": "A filed document's text. A visit summary, lab report, letter or bill. Long text comes in parts: pass next_offset as offset.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The document's id."
          },
          "person": {
            "type": "string",
            "description": "Its owner, for its private lines too."
          },
          "page": {
            "type": "integer",
            "description": "First page.",
            "minimum": 0
          },
          "offset": {
            "type": "integer",
            "description": "An earlier `next_offset`.",
            "minimum": 0
          }
        },
        "required": [
          "id"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "person": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "doc_type": {
            "type": "string"
          },
          "organization": {
            "type": "string"
          },
          "amount_due": {
            "type": "string"
          },
          "due_date": {
            "type": "string"
          },
          "text_chars": {
            "type": "integer"
          },
          "offset": {
            "type": "integer"
          },
          "next_offset": {
            "type": "integer"
          },
          "first_page": {
            "type": "integer"
          },
          "last_page": {
            "type": "integer"
          },
          "text_pages": {
            "type": "integer"
          },
          "text": {
            "type": "string"
          },
          "records": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "private": {
            "type": "string"
          },
          "provider_labels": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "hint": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "person",
          "text_chars",
          "offset",
          "first_page",
          "last_page",
          "text_pages",
          "text"
        ]
      },
      "annotations": {
        "title": "Read a document",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    }
  ]
}
